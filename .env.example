# Copy to .env and fill in. `docker compose` reads this file automatically.

# --- required ---------------------------------------------------------------
# Use URL-safe values for the password (it is embedded in the database URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs login tokens. Must be 32+ random characters or the API refuses to start:
#   openssl rand -hex 32
SECRET_KEY=

# --- optional ---------------------------------------------------------------
POSTGRES_USER=crm
POSTGRES_DB=crm
WEB_PORT=8080

# Features stay disabled (with a clear error in the UI) until their key is set.
ANTHROPIC_API_KEY=          # AI pitch, recommendations, assistant
GOOGLE_MAPS_API_KEY=        # lead discovery (+ PageSpeed scores in audits)
WHATSAPP_API_TOKEN=         # sending pitches
WHATSAPP_PHONE_NUMBER_ID=
# Meta requires a pre-approved template (not free-form text) for a lead's
# very first WhatsApp message. Register one in Meta Business Manager with
# a single {{1}} body variable (the business name) and put its name here.
# Leave blank to always send free-form — fine for replies, but Meta will
# reject first-touch sends to leads who've never messaged you.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Email (invites + password reset). Leave SMTP_HOST blank to skip email
# entirely — invites then return a one-time password for the admin to
# share directly, and "forgot password" quietly does nothing (by design,
# so it can't be used to probe which emails have accounts).
# Works with any SMTP provider: SES, SendGrid, Mailgun, Postmark, or a
# Gmail app-password relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true
# Must match the URL people actually open this app at — it's used to build
# the invite/reset links emailed to them. Same host as WEB_PORT below.
FRONTEND_URL=http://localhost:8080

# SMS campaigns (bulk outreach). Leave blank to disable SMS — email
# campaigns still work without this. Any Twilio trial/paid account works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Bulk campaigns: safety cap per send, and a small delay between each
# message so a 500-lead blast doesn't hammer the email/SMS provider.
CAMPAIGN_MAX_RECIPIENTS=1000
CAMPAIGN_DELAY_SECONDS=0.3

# The worker sends due/overdue follow-up notifications once a day after this hour.
# Containers run in UTC, so 8 means 08:00 UTC.
FOLLOWUP_SWEEP_HOUR=8

# Weekly digest email to ADMIN/SALES_MANAGER users (new leads, deals won,
# overdue follow-ups) — needs SMTP configured above to actually send.
# Day: Monday=0 ... Sunday=6. Hour is server-local (UTC in Docker).
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_HOUR=8

# Only for an external scheduler calling POST /api/notifications/system/check-followups.
# Not needed: the worker already does this sweep.
CRON_SECRET=
